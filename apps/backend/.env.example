NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:root@localhost:5432/postgres?schema=public"

# ── Redis Cache & Queues ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Backblaze B2 (S3-Compatible Cloud Object Storage) ─────────────────────────
# 1. Bucket Name created in Backblaze B2
B2_BUCKET_NAME=chatting-media

# 2. Region where your bucket is located (e.g. us-east-005, us-west-004, eu-central-003)
B2_REGION=us-east-005

# 3. S3 Endpoint (Optional: automatically derived from B2_REGION if left empty)
# Example: s3.us-east-005.backblazeb2.com
B2_ENDPOINT=s3.us-east-005.backblazeb2.com

# 4. Backblaze Application Key Credentials (from Application Keys tab)
B2_KEY_ID=your_backblaze_key_id_here
B2_APPLICATION_KEY=your_backblaze_application_key_here

# ── WebRTC / Coturn ──────────────────────────────────────────────────────────
COTURN_SECRET=coturn_super_secret_auth_key

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_access_key_12345678901234567890
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_12345678901234567890
