// ─────────────────────────────────────────────────────────────────────────────
// DATABASE NOTES FOR FUTURE MAINTAINERS
//
// FUTURE: Message table partitioning
//   When Message row count exceeds ~50M rows, consider native PostgreSQL
//   declarative partitioning on Message.createdAt (monthly or quarterly ranges).
//   Options:
//     - pg_partman extension for automatic partition creation/retention
//     - Manual DDL with CREATE TABLE Message_2025_Q1 PARTITION OF Message
//       FOR VALUES FROM ('2025-01-01') TO ('2025-04-01')
//   Migration path: create new partitioned table, back-fill in batches,
//   swap via atomic rename. Prisma's $executeRaw can drive the DDL.
//   Do NOT attempt this without a full DB backup and downtime window.
//
// FUTURE: Group chat enhancements
//   ConversationType.GROUP and ConversationMember.role are intentionally minimal.
//   When building full group-chat features, the following schema additions will
//   be needed (create a separate migration for each):
//     - Conversation: maxMembers Int @default(256), description String?,
//       inviteLinkToken String? @unique, muteUntil per-member
//     - ConversationMember: mutedUntil DateTime?, isAdmin Boolean, nickname String?
//     - New table: GroupInviteLink { id, conversationId, token, createdBy,
//       expiresAt, usageCount, maxUsage }
//   Enforce maxMembers at the application layer (ConversationService), not just DB.
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MEMBER
  ADMIN
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  SYSTEM
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SERVER_RECEIVED
  DELIVERED
  READ
  FAILED
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  DECLINED
  ENDED
  MISSED
  BUSY
}

// FIX 5: Added isActive + deletedAt for soft account deletion/deactivation.
// Use isActive=false + deletedAt=now for GDPR-compliant deletion (preserves
// foreign key integrity while hiding the account from all queries).
// Application layer MUST filter WHERE isActive = true on all user-facing queries.
model User {
  id            String               @id @default(uuid())
  phoneNumber   String               @unique
  username      String?              @unique
  displayName   String?
  avatarUrl     String?
  about         String?              @default("Hey there! I am using WhatsApp.")
  isActive      Boolean              @default(true)
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  devices       Device[]
  memberships   ConversationMember[]
  messages      Message[]
  identityKeys  IdentityKey[]
  signedPreKeys SignedPreKey[]
  oneTimePreKeys OneTimePreKey[]
  reactions     Reaction[]
  receipts      Receipt[]
  callsInitiated Call[]              @relation("CallerUser")
  callParticipations Participant[]
  blockedBy     BlockedUser[]        @relation("BlockerUser")
  blockedTarget BlockedUser[]        @relation("BlockedTargetUser")
  reportsFiled  Report[]             @relation("ReportReporter")
  reportsReceived Report[]           @relation("ReportReportedUser")
  settings      Setting?
  messageDeletions MessageDeletion[]
  attachmentDownloads AttachmentDownload[]
  createdSplits ExpenseSplit[]         @relation("CreatedSplits")
  paidSplits    ExpenseSplit[]         @relation("PaidSplits")
  participations ExpenseParticipant[]
  settlementsPaid ExpenseSettlement[]    @relation("SettlementsPaid")
  settlementsReceived ExpenseSettlement[] @relation("SettlementsReceived")

  @@index([phoneNumber])
  @@index([isActive])
  @@index([deletedAt])
}

model Device {
  id             String         @id @default(uuid())
  userId         String
  deviceId       Int
  deviceName     String
  platform       String
  fcmToken       String?
  lastActiveAt   DateTime       @default(now())
  createdAt      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  sentMessages   Message[]      @relation("SenderDevice")
  identityKeys   IdentityKey[]
  signedPreKeys  SignedPreKey[]
  oneTimePreKeys OneTimePreKey[]

  @@unique([userId, deviceId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  deviceId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // FIX 3: Daily cron job (TokenCleanupService) deletes rows WHERE expiresAt < now().
  // Index on expiresAt makes the DELETE fast even on large tables.
  @@index([expiresAt])
}

model IdentityKey {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String
  publicKey String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
}

model SignedPreKey {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String
  keyId      Int
  publicKey  String
  signature  String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, keyId])
}

model OneTimePreKey {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String
  keyId     Int
  publicKey String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, keyId])
  @@index([userId, deviceId, used])
}

model Conversation {
  id             String               @id @default(uuid())
  type           ConversationType
  title          String?
  avatarUrl      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  isSplitGroup   Boolean              @default(false)
  splitExpenseId String?              @unique

  members        ConversationMember[]
  messages       Message[]
  calls          Call[]
  splitExpense   ExpenseSplit?        @relation("SplitGroupExpense")
  linkedExpenses ExpenseSplit[]       @relation("ConversationExpenses")
}

model ConversationMember {
  id               String       @id @default(uuid())
  conversationId   String
  userId           String
  role             Role         @default(MEMBER)
  joinedAt         DateTime     @default(now())
  clearedHistoryAt DateTime?

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// FIX 2: Replaced deletedForUserIds String[] array column on Message with a
// dedicated MessageDeletion join table. Reasons:
//   - Postgres array columns require a GIN index for fast "has userId" checks;
//     without it, every getHistoricalMessages query does a full seq-scan on
//     the array for filtering. With crores of messages this becomes O(n).
//   - The join table allows a simple indexed lookup:
//       SELECT 1 FROM "MessageDeletion" WHERE "messageId"=$1 AND "userId"=$2
//     which hits the composite unique B-tree index in O(log n).
//   - deletedAt on this table enables future TTL cleanup if needed.
model MessageDeletion {
  id          String   @id @default(uuid())
  messageId   String
  userId      String
  deletedAt   DateTime @default(now())

  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

// FUTURE partitioning note: see top-of-file comment.
model Message {
  id                String         @id @default(uuid())
  /// Client-generated idempotency key — unique per sender to prevent duplicate inserts on retry
  clientMessageId   String?
  conversationId    String
  senderId          String
  senderDeviceId    String
  type              MessageType    @default(TEXT)
  /// Encrypted message payload. Nullable: cleared to null once all intended recipients
  /// have confirmed DELIVERED status (WhatsApp-style relay-only model — server is not
  /// the source of truth; each device's local DB holds the permanent copy).
  ciphertexts       Json?
  /// Timestamp when the server cleared ciphertexts after confirmed delivery.
  /// Null = content still present. Set = content has been wiped from server.
  contentClearedAt  DateTime?
  status            DeliveryStatus @default(SERVER_RECEIVED)
  replyToId         String?
  isEdited          Boolean        @default(false)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  conversation      Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User           @relation(fields: [senderId], references: [id], onDelete: Restrict)
  senderDevice      Device         @relation("SenderDevice", fields: [senderDeviceId], references: [id], onDelete: Restrict)
  replyTo           Message?       @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           Message[]      @relation("MessageReplies")

  attachments       Attachment[]
  reactions         Reaction[]
  receipts          Receipt[]
  deletions         MessageDeletion[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([deletedAt])
  @@index([contentClearedAt])
}

model Attachment {
  id              String    @id @default(uuid())
  messageId       String
  fileUrl         String
  fileName        String
  fileSize        Int
  mimeType        String
  contentEncoding String?   @default("identity")
  originalSize    Int?
  compressedSize  Int?
  width           Int?
  height          Int?
  durationSeconds Float?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  message         Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  downloads       AttachmentDownload[]

  @@index([deletedAt])
}

/// Tracks which conversation members have downloaded each attachment.
/// Used by the media-cleanup cron to know when it is safe to delete
/// the file from object storage (once ALL members have downloaded it,
/// or the 14-day retention window has elapsed).
model AttachmentDownload {
  id           String    @id @default(uuid())
  attachmentId String
  userId       String
  downloadedAt DateTime  @default(now())

  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, userId])
  @@index([attachmentId])
  @@index([downloadedAt])
}

model Receipt {
  id        String         @id @default(uuid())
  messageId String
  userId    String
  deviceId  String
  status    DeliveryStatus
  updatedAt DateTime       @default(now())

  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, deviceId])
  @@index([messageId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Call {
  id             String        @id @default(uuid())
  conversationId String
  callerId       String
  type           CallType
  status         CallStatus    @default(INITIATED)
  startedAt      DateTime      @default(now())
  endedAt        DateTime?

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller         User          @relation("CallerUser", fields: [callerId], references: [id], onDelete: Restrict)
  participants   Participant[]
}

model Participant {
  id        String     @id @default(uuid())
  callId    String
  userId    String
  status    CallStatus @default(INITIATED)
  joinedAt  DateTime?
  leftAt    DateTime?

  call      Call       @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
}

// FIX 4: Added @@index([blockedId]) for reverse-lookup ("who has blocked me?").
// The existing @@unique([blockerId, blockedId]) covers forward lookups efficiently.
model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedTargetUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Setting {
  id                String   @id @default(uuid())
  userId            String   @unique
  readReceipts      Boolean  @default(true)
  lastSeenVisibility String  @default("EVERYONE")
  profilePhotoVis   String   @default("EVERYONE")
  aboutVisibility   String   @default("EVERYONE")
  theme             String   @default("DARK")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// FIX 1: Report model redesigned for E2EE compatibility.
//
// PROBLEM: The old `messageContent String` field stored plaintext message text.
// In an E2EE system the server never has (or should have) access to plaintext,
// so storing it violates the security model — any server breach would expose
// the reported message content for all reports ever filed.
//
// CHOSEN APPROACH: "Client-side evidence bundle with explicit consent"
//
// When a user taps "Report", the mobile app:
//   1. Has already decrypted the message locally (it's in the chat UI)
//   2. Shows a consent dialog: "Your decrypted message will be sent to
//      moderators to review this report. Proceed?"
//   3. On confirm, sends: { messageId, reportedUserId, reason,
//      decryptedContent (the plaintext the reporter saw),
//      encryptedCiphertext (the raw ciphertext from the DB),
//      senderPublicKey }
//
// WHY NOT "store only messageId + encrypted":
//   - Moderators would need the recipient's private key to decrypt, which
//     is on-device only — making moderation impossible without breaking E2EE.
//   - The evidence bundle approach is the same model used by Signal and WhatsApp:
//     the REPORTER voluntarily shares what they saw. The server only ever
//     receives this plaintext in the specific report context, with consent.
//
// FIELD NOTES:
//   - decryptedContent: what the reporting user saw (explicit consent required)
//   - encryptedCiphertext: the raw ciphertext blob for cryptographic verification
//     that the reported content matches what was actually sent
//   - reporterConsentAt: timestamp proving the user consented before submission
//   - contextMessages: encrypted blobs of surrounding messages (optional,
//     for context) — moderation team can request decryption of specific ones
//     if needed via a separate secure flow
model Report {
  id                    String   @id @default(uuid())
  reporterId            String
  reportedUserId        String
  messageId             String?
  /// Plaintext content the reporting user saw — provided with explicit consent at report time.
  /// NEVER populated server-side; always submitted by the reporter's device after user confirmation.
  decryptedContent      String
  /// Raw ciphertext blob from the message — allows cryptographic verification that
  /// decryptedContent matches what was actually sent (moderator cross-check).
  encryptedCiphertext   String?
  /// ISO timestamp recording when the user explicitly consented to share decrypted content.
  reporterConsentAt     DateTime
  reason                String
  /// Encrypted ciphertext blobs of surrounding messages for context.
  /// Moderators request per-message decryption via a separate secure out-of-band flow.
  contextMessages       Json?
  status                String   @default("pending")
  createdAt             DateTime @default(now())

  reporter              User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser          User     @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model ExpenseSplit {
  id             String          @id @default(uuid())
  createdBy      String          // userId jisne split banaya
  paidBy         String?         // userId jisne paisa pay kiya (defaults to createdBy)
  title          String          // jaise "Goa Trip", "Dinner at XYZ"
  totalAmount    Decimal
  currency       String          @default("INR")
  splitType      String          @default("EQUAL") // EQUAL | EXACT | PERCENT | SHARES
  category       String          @default("OTHER") // FOOD | TRAVEL | RENT | ENTERTAINMENT | SHOPPING | BILLS | OTHER
  conversationId String?         // agar existing 1:1 chat se bana hai
  splitGroupId   String?         @unique // agar naya temp split-group bana hai (isse link)
  isOngoingGroup Boolean         @default(false) // permanent group (disables auto-delete)
  status         String          @default("ACTIVE") // ACTIVE | SETTLED
  createdAt      DateTime        @default(now())
  settledAt      DateTime?
  autoDeleteAt   DateTime?       // 24h grace period after settled for auto-delete

  creator        User            @relation("CreatedSplits", fields: [createdBy], references: [id], onDelete: Cascade)
  payer          User?           @relation("PaidSplits", fields: [paidBy], references: [id], onDelete: SetNull)
  conversation   Conversation?   @relation("ConversationExpenses", fields: [conversationId], references: [id], onDelete: SetNull)
  splitGroup     Conversation?   @relation("SplitGroupExpense", fields: [splitGroupId], references: [id], onDelete: SetNull)
  participants   ExpenseParticipant[]

  @@index([createdBy])
  @@index([paidBy])
  @@index([status])
  @@index([category])
  @@index([autoDeleteAt])
}

model ExpenseParticipant {
  id             String       @id @default(uuid())
  expenseSplitId String
  userId         String
  amountOwed     Decimal      // is participant ko kitna dena hai
  shareValue     Decimal?     // percentage or share weight
  isPaid         Boolean      @default(false)
  paidAt         DateTime?

  expenseSplit   ExpenseSplit @relation(fields: [expenseSplitId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseSplitId, userId])
  @@index([userId])
}

model ExpenseSettlement {
  id             String       @id @default(uuid())
  payerId        String
  receiverId     String
  amount         Decimal
  currency       String       @default("INR")
  notes          String?
  createdAt      DateTime     @default(now())

  payer          User         @relation("SettlementsPaid", fields: [payerId], references: [id], onDelete: Cascade)
  receiver       User         @relation("SettlementsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([payerId])
  @@index([receiverId])
}
