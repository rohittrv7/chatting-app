{
  "expo": {
    "name": "WhatsApp Connect",
    "slug": "whatsapp-connect",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366F1"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow WhatsApp Connect to access your camera for video calls.",
        "NSMicrophoneUsageDescription": "Allow WhatsApp Connect to access your microphone for voice and video calls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366F1"
      },
      "package": "com.anonymous.whatsappconnect",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "20c19279-cfd5-4dba-8594-3dabc6695bff"
      }
    },
    "owner": "rohitrv_7"
  }
